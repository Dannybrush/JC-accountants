# Resend API key used to email website enquiries (https://resend.com)
RESEND_API_KEY=
# Inbox that receives enquiries
ENQUIRY_TO=hello@jandc-accountants.co.uk
# Verified sender on the Resend domain
ENQUIRY_FROM="J&C Website <website@jandc-accountants.co.uk>"
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable analytics entirely.
PUBLIC_GA_ID=
